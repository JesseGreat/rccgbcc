# ---------------------------------------------------------------------------
# RCCG Bethel Christian Center · Sunday School Attendance
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL. Local: http://127.0.0.1:54321
# Hosted: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon (publishable) key. Safe for the browser: the anon role has no
# table or function access at all; everything is enforced by RLS and grants.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role (secret) key. SERVER ONLY. Bypasses RLS. Never prefix with
# NEXT_PUBLIC_, never import it into client components. Used by the rate-limited
# student API routes, teacher provisioning, and the CLI scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for PWA metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Per-IP rate limits for the student API routes (requests per window).
# Keep these generous: church WiFi or mobile-carrier NAT can put a whole hall
# behind a single IP address.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_MAX=600
RATE_LIMIT_MARK_MAX=200
RATE_LIMIT_ADD_MAX=60

# Secret salt for hashing browser device ids before they reach the database.
# Any long random string (e.g. `openssl rand -base64 32`). Keep it stable:
# changing it mid-service resets every phone's device-cap count for that day.
DEVICE_HASH_SALT=

# ---------------------------------------------------------------------------
# CLI scripts only (pnpm db:migrate, db:seed, create-super-admin, test:e2e).
# Not needed on Vercel.
# ---------------------------------------------------------------------------

# Postgres connection string for `pnpm db:migrate`.
# Supabase dashboard → Connect → "Session pooler". Contains your DB password: keep it private.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Accounts created by `pnpm db:seed` (local sample data only).
SEED_SUPER_ADMIN_EMAIL=admin@bethel.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=

# Optional: password for `pnpm create-super-admin` (otherwise prompted).
# SUPER_ADMIN_PASSWORD=

# End-to-end tests (pnpm test:e2e). They refuse to run against a hosted
# Supabase project unless E2E_ALLOW_REMOTE=1. Use a disposable test project.
# E2E_BASE_URL=http://127.0.0.1:3100
# E2E_TEACHER_EMAIL=teens.teacher@bethel.local
# E2E_TEACHER_CLASS=Teens
# CHROME_PATH=/usr/bin/google-chrome
# E2E_ALLOW_REMOTE=0
